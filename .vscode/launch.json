{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tests: Pytest (workspace)",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "args": [
                "tests"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": false,
            "purpose": [
                "debug-test"
            ]
        },
        {
            "name": "Tests: Pytest (file)",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "args": [
                "${relativeFile}"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": false,
            "purpose": [
                "debug-test"
            ]
        },
        {
            "name": "Tests: Pytest (-k filter)",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "args": [
                "-k",
                "${input:pytestFilter}",
                "tests"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": false
        },
        {
            "name": "Scripts: Validate config",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/validate_config.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": true
        },
        {
            "name": "Scripts: Embed translations",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/embed_translations.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": true
        },
        {
            "name": "Scripts: Performance snapshot",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/performance_snapshot.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": true
        },
        {
            "name": "Python: Current file",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "pytestFilter",
            "type": "promptString",
            "description": "Pytest -k expression",
            "default": "parity"
        }
    ]
}
